# KDB-X / KDB+ database connection
KDBX_DB_HOST=127.0.0.1
KDBX_DB_PORT=5000
KDBX_DB_USERNAME=
KDBX_DB_PASSWORD=
KDBX_DB_TIMEOUT=1
KDBX_DB_RETRY=2
KDBX_DB_TLS=false

# MCP server
KDBX_MCP_TRANSPORT=streamable-http   # or stdio
KDBX_MCP_HOST=127.0.0.1
KDBX_MCP_PORT=8000
KDBX_MCP_LOG_LEVEL=INFO

# Optional: Anthropic API key (only needed if calling the API directly from tools)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: alerting integrations
SLACK_WEBHOOK_URL=
